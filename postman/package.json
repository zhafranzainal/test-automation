{
  "name": "postman-newman-api-automation",
  "version": "1.0.0",
  "description": "API automation suite using Postman collections executed with Newman",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:api",
    "test:api": "newman run automationexercise.postman_collection.json -e automationexercise.postman_environment.json",
    "test:report": "newman run automationexercise.postman_collection.json -e automationexercise.postman_environment.json -r cli,htmlextra --reporter-htmlextra-export newman-report/report.html",
    "test:ci": "newman run automationexercise.postman_collection.json -e automationexercise.postman_environment.json -r cli,junit,htmlextra --reporter-junit-export newman-report/results.xml --reporter-htmlextra-export newman-report/report.html"
  },
  "keywords": [
    "api",
    "automation",
    "postman",
    "newman",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1"
  }
}
