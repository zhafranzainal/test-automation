    {
      "name": "User Account Lifecycle",
      "description": "Run in order (matches playwright test.describe.serial in account.spec.ts): create -> login -> fetch -> update -> delete. Each request stores/reuses testUserName, testUserEmail, testUserPassword environment variables generated in API 11.",
      "item": [
        {
          "name": "API 11: POST To Create/Register User Account",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const timestamp = Date.now();\r",
                  "\r",
                  "pm.environment.set('testUserName', `QA Tester ${timestamp}`);\r",
                  "pm.environment.set('testUserEmail', `qa.tester.${timestamp}@example.com`);\r",
                  "pm.environment.set('testUserPassword', 'Test@1234');"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const body = pm.response.json();\r",
                  "\r",
                  "pm.test(\"responseCode is 201\", () => {\r",
                  "    pm.expect(body.responseCode).to.eql(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"message confirms user created\", () => {\r",
                  "    pm.expect(body.message).to.eql(\"User created!\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
