      "name": "Products List",
      "item": [
        {
          "name": "API 1: Get All Products List",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const body = pm.response.json();\r",
                  "\r",
                  "pm.test(\"responseCode is 200\", () => {\r",
                  "    pm.expect(body.responseCode).to.eql(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"products is a non-empty array\", () => {\r",
                  "    pm.expect(Array.isArray(body.products)).to.be.true;\r",
                  "    pm.expect(body.products.length).to.be.greaterThan(0);\r",
                  "});"
                ],
